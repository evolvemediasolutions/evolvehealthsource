# Neon Database URL (PostgreSQL Connection String)
# Example: postgresql://neondb_owner:password@ep-cool-glade-a5tnyuqo.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=your_neon_database_url_here

# MailerSend API Key
# Example: mlsn.yousupersecretapikeyhere
MAILERSEND_API_KEY=your_mailersend_api_key_here

# MailerSend From Email (must be verified domain, or MS_XXXXXX@trial-XXXXXX.mlsender.net for trials)
MAILERSEND_FROM_EMAIL=MS_XXXXXX@trial-XXXXXX.mlsender.net

# Destination email where contact notifications will be sent
MAILERSEND_TO_EMAIL=chitra@evolvehealthsource.com

# Server Port
PORT=3001
