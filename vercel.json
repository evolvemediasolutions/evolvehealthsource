{
  "version": 2,
  "redirects": [
    {
      "source": "/rcm",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rcm/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rcm/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rcm/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/solutions",
      "destination": "/index.html"
    },
    {
      "source": "/services",
      "destination": "/index.html"
    },
    {
      "source": "/insights",
      "destination": "/index.html"
    },
    {
      "source": "/insights/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/careers",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/contact/thank-you",
      "destination": "/index.html"
    },
    {
      "source": "/thank-you",
      "destination": "/index.html"
    },
    {
      "source": "/marketing/home",
      "destination": "/index.html"
    },
    {
      "source": "/myclinicboot",
      "destination": "/index.html"
    },
    {
      "source": "/myclinicboost",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    }
  ]
}