{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/rcm",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rcm/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rcm/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rcm/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/solutions",
      "destination": "/solutions/index.html"
    },
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/insights",
      "destination": "/insights/index.html"
    },
    {
      "source": "/insights/navigating-icd-10-updates-2026",
      "destination": "/insights/navigating-icd-10-updates-2026/index.html"
    },
    {
      "source": "/insights/strategies-reduce-claim-denials",
      "destination": "/insights/strategies-reduce-claim-denials/index.html"
    },
    {
      "source": "/insights/ai-in-modern-ar-management",
      "destination": "/insights/ai-in-modern-ar-management/index.html"
    },
    {
      "source": "/insights/:slug",
      "destination": "/insights/index.html"
    },
    {
      "source": "/careers",
      "destination": "/careers/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/contact/thank-you",
      "destination": "/contact/thank-you/index.html"
    },
    {
      "source": "/thank-you",
      "destination": "/contact/thank-you/index.html"
    },
    {
      "source": "/marketing/home",
      "destination": "/marketing/home/index.html"
    },
    {
      "source": "/myclinicboot",
      "destination": "/myclinicboot/index.html"
    },
    {
      "source": "/myclinicboost",
      "destination": "/myclinicboost/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    }
  ]
}
